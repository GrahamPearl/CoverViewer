# viewer.env — Firebase configuration for Cover Data Viewer
# Copy this file, fill in your Firebase credentials, and ensure it's in the same directory as viewer.html
# Format: KEY=VALUE (no quotes needed)

# Firebase Project Credentials
apiKey=YOUR_API_KEY_HERE
projectId=YOUR_PROJECT_ID_HERE
authDomain=YOUR_PROJECT.firebaseapp.com
storageBucket=YOUR_PROJECT.appspot.com
messagingSenderId=YOUR_SENDER_ID_HERE
appId=YOUR_APP_ID_HERE

# School Identifier (used as Firestore document path)
schoolId=your-school-id

# Example:
# apiKey=AIza1234567890abcdefghijklmnopqrstuv
# projectId=my-cover-project
# authDomain=my-cover-project.firebaseapp.com
# storageBucket=my-cover-project.appspot.com
# messagingSenderId=123456789012
# appId=1:123456789012:web:abc123def456ghi789
# schoolId=springfield-high
